# ==========================================
# .gitignore para Proyecto Vitalis Care (.NET 9 + Node.js)
# ==========================================

# Compilación y artefactos .NET
bin/
obj/
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Base de datos local SQLite y archivos temporales
*.db-shm
*.db-wal
citasmedicas.db-shm
citasmedicas.db-wal

# Archivos de configuración de producción y secretos
appsettings.Production.json
secrets.json
.env
.env.local
.env.*.local

# User Secrets de ASP.NET Core (almacenados fuera del repo por defecto en %APPDATA%/Microsoft/UserSecrets)
# Se garantiza que no se suban credenciales en texto claro

# Node.js / NPM
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Herramientas de diagnóstico y logs
*.log
.system_generated/
.firebase/
App_Data/logs/
TestResults/
reports/nbomber-report/

# IDEs y Editores
.vs/
.vscode/
*.swp
*.lock
.DS_Store
Thumbs.db
